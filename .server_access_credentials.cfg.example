# Template for OGAL local configuration.
# Copy this file to .server_access_credentials.cfg and replace every placeholder
# with your actual absolute paths.  The real file is listed in .gitignore and must
# never be committed to the repository.
#
# Configuration is loaded by misc/config.py.  Keys in each section are prefixed
# with the section name: e.g. OUTPUT_PATH in [LOCAL] becomes LOCAL_OUTPUT_PATH.
# Highest-priority source wins: CLI args > this file > exp_config.yaml > defaults.

# ---------------------------------------------------------------------------
# [LOCAL] — required for every local run (laptop / workstation)
# ---------------------------------------------------------------------------
[LOCAL]
# Absolute path where experiment result directories will be written.
OUTPUT_PATH = /absolute/path/to/results

# Absolute path to the directory containing preprocessed dataset CSV files.
DATASETS_PATH = /absolute/path/to/datasets

# Optional: absolute path to the repository root (used by some helper scripts).
# CODE_PATH = /absolute/path/to/repo

# ---------------------------------------------------------------------------
# [HPC] — required only when RUNNING_ENVIRONMENT=hpc (SLURM cluster)
# ---------------------------------------------------------------------------
[HPC]
# SSH login for the cluster head node (used when submitting from a local machine).
SSH_LOGIN = your_login@your.cluster.example.edu

# Absolute path to the workspace directory on the cluster file system.
WS_PATH = /absolute/path/to/workspace

# Absolute path to the Python interpreter inside the conda/poetry environment on HPC.
PYTHON_PATH = /absolute/path/to/conda-env/bin/python

# Result and dataset paths on the cluster (can differ from [LOCAL] paths).
OUTPUT_PATH = /absolute/path/to/results
DATASETS_PATH = /absolute/path/to/datasets

# SLURM account and notification email.
SLURM_PROJECT = your_slurm_project_account
SLURM_MAIL = your.email@example.com
